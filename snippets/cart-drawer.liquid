{%- doc -%}
  Renders the cart drawer, a slide-out panel that displays the contents of the cart. It includes the cart icon that acts as a trigger.

  @param {object} [settings] - An object containing theme settings.

  @param {boolean} [settings.auto_open_cart_drawer] - If `true`, the cart drawer opens automatically after an item is
  added.
  @param {string} [settings.drawer_color_scheme] - The color scheme for the drawer.
{%- enddoc -%}

<script
  src="{{ 'cart-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- if settings.nesovi_upsell_enable -%}
  {%- comment -%}
    Loaded unconditionally (not from inside the cart-not-empty branch below) so its
    cart:update listener is already attached before a customer's first add-to-cart —
    see the comment in assets/nesovi-cart-upsell.js for why that matters.
  {%- endcomment -%}
  <script
    src="{{ 'nesovi-cart-upsell.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}

<cart-drawer-component
  class="cart-drawer"
  {{ block.shopify_attributes }}
  {% if settings.auto_open_cart_drawer %}
    auto-open
  {% endif %}
>
  <button
    class="button header-actions__action button-unstyled"
    on:click="/open"
    aria-label="{{ 'accessibility.open_cart_drawer' | t }} {{ 'accessibility.cart_count' | t}}: {{ cart.item_count }}"
  >
    {% render 'cart-icon-component' %}
  </button>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{%endif%}"
    scroll-lock
  >
    <div class="cart-drawer__inner">
      <cart-items-component
        class="cart-items-component"
        data-section-id="{{ section.id }}"
      >
        {%- if cart.empty? -%}
          <div class="cart-drawer__header">
            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            <span class="cart-drawer__heading h3 cart-drawer__heading--empty">
              {{ 'content.your_cart_is_empty' | t }}
            </span>

            <div class="cart-drawer__items">
              {% render 'cart-products' %}
            </div>
          </div>
        {%- else -%}
          <div
            class="cart-drawer__header"
            id="cart-drawer-header"
          >
            <span class="cart-drawer__heading h3">
              Your Cart
              {% render 'cart-bubble' %}
            </span>

            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <p class="cart-drawer__subheading">Review your order</p>

          {% comment %}CART DRAWER AUTO PROGRESS BAR SNIPPET

          <div id="combo-progress-wrapper" class="combo-progress-wrapper">
          <p id="combo-progress-text">Add 5 necklaces to unlock ₹999 combo offer</p>
          <div class="combo-progress-bar-bg">
          <div id="combo-progress-bar-fill" class="combo-progress-bar-fill"></div>
          </div>
          </div>


          <style>
          .combo-progress-wrapper{padding:15px;background:#f8f8f8;border-radius:12px;margin:10px 0;text-align:center}
          .combo-progress-bar-bg{width:100%;height:10px;background:#ddd;border-radius:10px;margin-top:8px}
          .combo-progress-bar-fill{height:10px;background:#000;border-radius:10px;width:0%}
          </style>
          {% endcomment %}

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
            style="--header-height: 60px;"
          >
            <scroll-hint
              class="cart-drawer__items"
            >
              {% render 'cart-products' %}
              {% render 'nesovi-cart-upsell' %}
            </scroll-hint>

            <div
              class="cart-drawer__summary"
              style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--gap-md);"
            >
              {% render 'cart-summary' %}
            </div>
          </div>
        {%- endif -%}
      </cart-items-component>
    </div>
  </dialog>
</cart-drawer-component>

{% stylesheet %}
  .cart-items-component {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-drawer__heading .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
    min-width: 26px;
  }

  .cart-drawer__header {
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--cart-drawer-padding);
    border-bottom: var(--style-border-width) solid none;
    position: sticky;
    top: 0;
    z-index: 1;

    @media screen and (min-width: 750px) {
      padding: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-drawer__dialog {
    overflow: hidden;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  /* Keep the scrollable line-items area growing/shrinking to fill the drawer;
     the upsell carousel and footer below it stay put, out of the scroll. */
  .cart-drawer .cart-drawer__items {
    flex: 1 1 auto;
    min-height: 0;
    padding-inline: var(--padding-sm);
  }

  .cart-drawer #nesovi-cart-upsell {
    flex-shrink: 0;
    margin-block-end: 0;
    /* Break out of the item list's inline padding so the panel runs edge-to-edge. */
    margin-inline: calc(var(--padding-sm) * -1);
  }

  .cart-drawer__summary {
    background-color: var(--color-background);
    position: sticky;
    bottom: 0;
    z-index: 1;
  }

  .cart-drawer__subheading {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    padding: 0 var(--cart-drawer-padding) var(--padding-3xs);

    @media screen and (min-width: 750px) {
      padding: 0 var(--cart-drawer-padding-desktop) var(--padding-3xs);
    }
  }

  .cart-drawer .cart-drawer__heading.h3 {
    font-size: 20px;
  }

  .cart-drawer .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-md);
    margin-bottom: var(--gap-md);
  }

  /* ── Item rows: price lives under the title already (unit price); hide the
     redundant line-total column and use that space for qty + remove instead ── */
  .cart-drawer .cart-items__table-row {
    grid-template-columns: 5.5rem 1fr;
    grid-template-areas:
      'media details'
      'media quantity'
      'media error';
    align-items: stretch;
  }

  .cart-drawer .cart-items__price {
    display: none;
  }

  .cart-drawer .cart-items__media {
    align-self: center;
  }

  .cart-drawer .cart-items__title {
    font-weight: 700 !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    line-height: 1.3 !important;
    max-width: 100%;
  }

  .cart-drawer .cart-items__quantity {
    grid-area: quantity;
    align-self: center;
    margin-block-start: var(--margin-2xs);
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-drawer .quantity-selector {
    --quantity-selector-width: 120px;
    flex: 0 0 auto;
    align-self: auto;
  }

  .cart-drawer .quantity-selector:hover {
    border-color: #c9a66b;
  }

  .cart-drawer .cart-items__remove {
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
  }

  .cart-drawer .cart-items__remove:hover {
    border-color: #c9a66b;
    color: #c9a66b;
  }

  /* ── Footer: price + tax note on the left, compact checkout button on the right ── */
  .cart-drawer .cart-drawer__summary {
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: nowrap !important;
  }

  .cart-drawer .cart__summary-totals {
    flex: 1 1 auto !important;
    width: auto !important;
    min-width: 0;
    overflow: hidden;
    border-block-start: none !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
  }

  /* The divider now lives on the full-width footer, not the (shrunk) price column.
     var(--color-border) is a ~6% tint here and is invisible on white, so use a solid tone. */
  .cart-drawer .cart-drawer__summary {
    border-block-start: 1px solid #e5e5e5;
  }

  .cart-drawer .cart__total-container {
    align-items: flex-start;
  }

  .cart-drawer .cart__total-label {
    display: none;
  }

  .cart-drawer .cart__total-value {
    font-size: 22px;
    font-weight: 700;
    color: #1a1a1a;
    white-space: nowrap;
  }

  .cart-drawer .cart__summary-item.cart__total {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-3xs);
  }

  .cart-drawer .cart__total-compare {
    margin-inline-start: 0;
  }

  .cart-drawer .cart__summary-item.cart__total {
    justify-content: flex-start;
  }

  .cart-drawer .tax-note {
    display: none;
  }

  .cart-drawer .cart__ctas {
    flex: 0 0 auto !important;
    width: auto !important;
    min-width: unset !important;
  }

  .cart-drawer .flexy-label {
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 700;
  }
{% endstylesheet %}
