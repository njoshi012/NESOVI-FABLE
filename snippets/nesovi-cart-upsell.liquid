{%- liquid
  assign upsell_enabled = settings.nesovi_upsell_enable
  assign upsell_limit = settings.nesovi_upsell_limit | default: 3
  assign upsell_source = settings.nesovi_upsell_source | default: 'auto'

  assign collection_products = blank
  for c in settings.nesovi_upsell_collections
    if collection_products == blank
      assign collection_products = c.products
    else
      assign collection_products = collection_products | concat: c.products
    endif
  endfor
-%}

{%- if upsell_enabled and cart.item_count > 0 -%}
  {%- comment -%}
    data-skip-node-update / data-skip-subtree-update tell the theme's section morph (assets/morph.js)
    to leave this element and its children alone on every cart-triggered header re-render. Without
    these, the drawer's Section Rendering refresh resets this node back to its blank/hidden server
    markup after every add-to-cart, wiping out whatever assets/nesovi-cart-upsell.js just rendered
    into .nesovi-cu-items.
  {%- endcomment -%}
  <div
    class="nesovi-cu"
    id="nesovi-cart-upsell"
    data-limit="{{ upsell_limit }}"
    data-source="{{ upsell_source }}"
    data-skip-node-update
    data-skip-subtree-update
    hidden
  >
    <h4 class="nesovi-cu-title">{{ settings.nesovi_upsell_heading }}</h4>
    <div class="nesovi-cu-items"></div>
  </div>

  {%- if upsell_source == 'products' -%}
    <script type="application/json" data-nesovi-cu-data>{{ settings.nesovi_upsell_products | json }}</script>
  {%- elsif upsell_source == 'collections' -%}
    <script type="application/json" data-nesovi-cu-data>{{ collection_products | json }}</script>
  {%- endif -%}

  <style>
    .nesovi-cu{--gold:#c9a66b;--gold-soft:#f4ead9;background:#f8f2e7;padding:10px 0;margin:10px 0}
    .nesovi-cu[hidden]{display:none}
    .nesovi-cu-title{font-size:13px;font-weight:600;color:#1a1a1a;margin:0 0 6px 10px}

    .nesovi-cu-items{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:2px 10px 4px 0;margin-left: 10px;}
    .nesovi-cu-items::-webkit-scrollbar{display:none}

    .nesovi-cu-item{scroll-snap-align:start;flex:0 0 92px;background:#fff;border-radius:8px;overflow:hidden;border:1px solid var(--gold-soft)}

    .nesovi-cu-imgwrap{position:relative;aspect-ratio:1;background:#f5f5f5}
    .nesovi-cu-imgwrap img{width:100%;height:100%;object-fit:cover;display:block}

    .nesovi-cu-add{position:absolute;right:4px;bottom:4px;width:20px;height:20px;border-radius:6px;background:#1a1a1a;color:#fff;border:none;font-size:13px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
    .nesovi-cu-add:hover{background:#000}
    .nesovi-cu-add:disabled{background:#ccc;cursor:default}

    .nesovi-cu-info{padding:6px 6px 8px}
    .nesovi-cu-info h6{font-size:10px;font-weight:500;margin:0 0 4px;color:#1a1a1a;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.3;min-height:24px}

    .nesovi-cu-price-row{display:flex;align-items:center;gap:4px;flex-wrap:wrap}
    .nesovi-cu-price{font-size:11px;font-weight:700;color:#1a1a1a}
    .nesovi-cu-compare{font-size:10px;color:#999;text-decoration:line-through}
    .nesovi-cu-off{font-size:10px;font-weight:600;color:#1f9d55}
  </style>
{%- endif -%}
